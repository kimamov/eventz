{
  "name": "eventz",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @eventz/web dev",
    "build": "bun --filter '*' build",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "bun --filter @eventz/db db:generate",
    "db:migrate": "bun --filter @eventz/db db:migrate",
    "db:studio": "bun --filter @eventz/db db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5"
  }
}
